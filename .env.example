# ============================================
# CONFIGURAÇÃO DE AMBIENTE - YOUR LIFE
# ============================================
# Copie este arquivo para .env e preencha com valores reais
# NUNCA comite o arquivo .env no Git!

# Servidor
PORT=3000
NODE_ENV=development

# JWT - OBRIGATÓRIO
# Gere uma chave segura com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA use o exemplo abaixo em produção!
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_REAL_GERADA_PELO_COMANDO_ACIMA

# Canal público para exercício de direitos LGPD / contato do encarregado
PRIVACY_CONTACT_EMAIL=

# CORS
# Use '*' para desenvolvimento ou especifique domínios separados por vírgula
# Exemplo produção: CORS_ORIGIN=https://seu-dominio.com
CORS_ORIGIN=*

# PostgreSQL (Neon/Vercel)
# No Vercel, essas variáveis são configuradas automaticamente ao conectar o banco
# Para desenvolvimento local, copie do Vercel Dashboard → Storage → Neon → Connection String
POSTGRES_URL=postgresql://usuario:senha@host.neon.tech:5432/banco?sslmode=require

# Vercel Blob - upload e armazenamento de imagens
BLOB_READ_WRITE_TOKEN=

# Amazon Rekognition - moderação de imagens antes da publicação
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MODERATION_MIN_CONFIDENCE=80
MODERATION_DENY_LABELS=Explicit Nudity,Sexual Activity,Graphic Male Nudity,Graphic Female Nudity

# Ably - entrega instantânea de eventos do chat; polling continua como fallback
ABLY_API_KEY=

# LiveKit - chamadas de voz, vídeo e compartilhamento de tela
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
